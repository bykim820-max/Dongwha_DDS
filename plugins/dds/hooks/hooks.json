{
  "description": "DDS 새 버전 알림 — DDS를 쓰는 프로젝트를 열 때 고정 버전보다 새 버전이 있으면 알린다",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
